table Customer
	lineageTag: 6c1f0a3e-2b4d-4e5f-8a90-00000000001b

	measure 'Customer Count' = DISTINCTCOUNT(Customer[CustomerKey])
		formatString: #,0
		lineageTag: 6c1f0a3e-2b4d-4e5f-8a90-00000000001c

	column CustomerKey
		dataType: int64
		formatString: 0
		lineageTag: 6c1f0a3e-2b4d-4e5f-8a90-000000000017
		summarizeBy: none
		sourceColumn: CustomerKey

	column 'Customer Name'
		dataType: string
		lineageTag: 6c1f0a3e-2b4d-4e5f-8a90-000000000018
		summarizeBy: none
		sourceColumn: Customer Name

	column City
		dataType: string
		lineageTag: 6c1f0a3e-2b4d-4e5f-8a90-000000000019
		summarizeBy: none
		sourceColumn: City

	column Segment
		dataType: string
		lineageTag: 6c1f0a3e-2b4d-4e5f-8a90-00000000001a
		summarizeBy: none
		sourceColumn: Segment

	partition Customer = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Data\customer.csv"), [Delimiter=",", Columns=4, Encoding=65001]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
					Promoted

	annotation PBI_ResultType = Table
