/// Customers who placed orders.
table Customer
	lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-000000000027

	measure 'Customer Count' = DISTINCTCOUNT(Customer[CustomerKey])
		formatString: #,0
		lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-00000000001b

	measure 'Old Customer Count' = COUNTROWS(Customer)
		formatString: #,0
		isHidden
		lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-00000000001c

	/// Customer identifier.
	column CustomerKey
		dataType: int64
		formatString: 0
		lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-00000000001d
		summarizeBy: none
		sourceColumn: CustomerKey

	/// Customer name.
	column 'Customer Name'
		dataType: string
		lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-00000000001e
		summarizeBy: none
		sourceColumn: Customer Name

	/// City of the customer's billing address.
	column City
		dataType: string
		lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-00000000001f
		summarizeBy: none
		sourceColumn: City

	/// Customer segment.
	column Segment
		dataType: string
		lineageTag: 6c1f0a3e-2b4d-4e5f-9b01-000000000020
		summarizeBy: none
		sourceColumn: Segment

	partition Customer = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Data\customer.csv"), [Delimiter=",", Columns=4, Encoding=65001]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
					Promoted

	annotation PBI_ResultType = Table
