model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Sales","Product","Customer","Calendar","Targets"]

ref table Sales
ref table Product
ref table Customer
ref table Calendar
ref table Targets
